{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lelf"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger."
        },
        { 
            "label": "Run compiled ELF", 
            "type": "shell", 
            "command": "${fileDirname}/${fileBasenameNoExtension} example", 
            "options": { 
                "cwd": "${fileDirname}" 
            }, 
            "group": "none", 
            "presentation": { 
                "echo": true, 
                "reveal": "always", 
                "focus": false, 
                "panel": "shared" 
            }, 
            "problemMatcher": [] 
        }
    ],
    "version": "2.0.0"
}